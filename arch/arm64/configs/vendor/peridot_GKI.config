# Charger
CONFIG_MI_DTPT=y
CONFIG_MI_ENABLE_DP=y

# Debug
CONFIG_MI_DUMP_DISPLAY=m
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m
# CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG is not set
# CONFIG_INTERCONNECT_TEST is not set
# CONFIG_NL80211_TESTMODE is not set
# CONFIG_QCOM_DYN_MINIDUMP_STACK is not set
# CONFIG_QCOM_IOMMU_DEBUG is not set
# CONFIG_QCOM_MINIDUMP_FTRACE is not set
# CONFIG_QTI_BATTERY_GLINK_DEBUG is not set
# CONFIG_QTI_CHARGER_ULOG_GLINK is not set
# CONFIG_QTI_PMIC_GLINK_DEBUG is not set
# CONFIG_QTI_THERMALZONE_CONFIG_DEBUG is not set
# CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_XLOGCHAR is not set

# Runtime sanitizers
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set

# Fingerprint
CONFIG_FINGERPRINT_MI_FP=m
CONFIG_INPUT_FINGERPRINT=y

# HWID
CONFIG_MI_HARDWARE_ID=m

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Joystick
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# Net
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y

# Regulators
CONFIG_REGULATOR_WL2866D=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Vibrator
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set
CONFIG_INPUT_AW86927_HAPTIC=m
CONFIG_SIH_VIBRATOR=m

CONFIG_LOCALVERSION_AUTO=n
CONFIG_LOCALVERSION="-Zen-Itsu"

# Compiler optimization
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG_FULL=y
# CONFIG_LTO_CLANG_THIN is not set

# Serial console
# CONFIG_SERIAL_QCOM_GENI_CONSOLE is not set
